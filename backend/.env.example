# AI-CT TEACHER backend — environment variables.
#
# GEMINI_API_KEY is stored as a Cloudflare Worker SECRET, never in a file
# in this repository:
#
#   wrangler secret put GEMINI_API_KEY
#
# Do not commit a real key under any filename. This placeholder file is safe
# to commit only because the value below is empty.

GEMINI_API_KEY=

# Optional: override the Gemini model without editing code (a plain
# Worker variable, not a secret). Default in worker.js: gemini-2.5-flash
# GEMINI_MODEL=
